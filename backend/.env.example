# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-key

# ── Database (PostgreSQL via Supabase) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Auth is handled by Supabase Auth (see SUPABASE_URL/keys above) — no separate
# secret/token-expiry config is needed here.

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# ── PageIndex (vectorless RAG) ────────────────────────────────────────────────
PAGEINDEX_API_KEY=your-pageindex-api-key
PAGEINDEX_DOC_ID=pi-cmolqaneu06jf01qq1coymxsw
